{
  "info": {
    "_postman_id": "692274c7-9fd7-4328-a0d7-b6378718541e",
    "name": "Hub de Leitura - Testes API EBAC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection de testes funcionais da API Hub de Leitura, com foco no Catálogo de Livros. Antes de executar, configure o ambiente ServerRest com base_Url_Hub=http://localhost:3000, adminToken vazio e bookId vazio. Execute a collection na ordem definida: Login, Adicionar, Buscar, Atualizar e Excluir. A requisição de criação salva bookId; o login admin salva adminToken."
  },
  "item": [
    {
      "name": "Login",
      "item": [
        {
          "name": "login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Login admin deve retornar 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Resposta deve conter token\", function () {",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Resposta deve identificar o perfil administrador\", function () {",
                  "    pm.expect(json.isAdmin).to.eql(true);",
                  "});",
                  "",
                  "pm.environment.set(\"adminToken\", json.token.replace(/^Bearer\\s+/i, \"\"));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@biblioteca.com\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_Url_Hub}}/api/login",
              "host": [
                "{{base_Url_Hub}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "login usuário comum",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Login de usuário comum deve retornar 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Login deve retornar token\", function () {",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Token deve ter formato JWT\", function () {",
                  "    const token = json.token.replace(/^Bearer\\s+/i, \"\");",
                  "    pm.expect(token.split(\".\")).to.have.lengthOf(3);",
                  "});",
                  "",
                  "pm.test(\"Usuário comum não deve ser administrador\", function () {",
                  "    pm.expect(json.isAdmin).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@teste.com\",\n  \"password\": \"user123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_Url_Hub}}/api/login",
              "host": [
                "{{base_Url_Hub}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
