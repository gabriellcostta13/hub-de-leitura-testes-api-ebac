    {
      "name": "Adicionar",
      "item": [
        {
          "name": "adicionar novo livro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Status code deve ser 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Mensagem deve confirmar a criação\", function () {",
                  "    pm.expect(json.message).to.eql(\"Livro criado com sucesso.\");",
                  "});",
                  "",
                  "pm.test(\"Livro criado deve possuir ID numérico\", function () {",
                  "    pm.expect(json.book.id).to.be.a(\"number\");",
                  "});",
                  "",
                  "pm.test(\"Título retornado deve corresponder ao Body\", function () {",
                  "    pm.expect(json.book.title).to.eql(\"Fronteira Digital\");",
                  "});",
                  "",
                  "pm.test(\"Autor retornado deve corresponder ao Body\", function () {",
                  "    pm.expect(json.book.author).to.eql(\"Lucas Oliveira\");",
                  "});",
                  "",
                  "pm.test(\"Categoria retornada deve corresponder ao Body\", function () {",
                  "    pm.expect(json.book.category).to.eql(\"Ficção Científica\");",
                  "});",
                  "",
                  "pm.test(\"ISBN retornado deve corresponder ao Body\", function () {",
                  "    pm.expect(json.book.isbn).to.eql(\"9780000000258\");",
                  "});",
                  "",
                  "if (json.book && json.book.id) {",
                  "    pm.environment.set(\"bookId\", json.book.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fronteira Digital\",\n  \"author\": \"Lucas Oliveira\",\n  \"description\": \"Uma aventura fictícia sobre inteligência artificial e mundos virtuais.\",\n  \"category\": \"Ficção Científica\",\n  \"isbn\": \"9780000000258\",\n  \"editor\": \"Editora Futuro\",\n  \"language\": \"Português\",\n  \"publication_year\": 2026,\n  \"pages\": 240,\n  \"format\": \"Físico\",\n  \"total_copies\": 5,\n  \"available_copies\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
