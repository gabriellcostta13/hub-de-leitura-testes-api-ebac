        {
          "name": "adicionar livro inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code deve ser 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"API deve informar erro de validação\", function () {",
                  "    pm.expect(json.message).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Campo obrigatório ausente deve ser author\", function () {",
                  "    pm.expect(json.field).to.eql(\"author\");",
                  "});",
                  "",
                  "pm.test(\"Body de teste deve conter o título esperado\", function () {",
                  "    pm.expect(JSON.parse(pm.request.body.raw).title).to.eql(\"O Código do Universo Perdido\");",
                  "});",
                  "",
                  "pm.test(\"Body de teste deve conter a categoria esperada\", function () {",
                  "    pm.expect(JSON.parse(pm.request.body.raw).category).to.eql(\"Ficção Científica\");",
                  "});",
                  "",
                  "pm.test(\"Body de teste deve conter o ISBN esperado\", function () {",
                  "    pm.expect(JSON.parse(pm.request.body.raw).isbn).to.eql(\"9780000000111\");",
                  "});",
                  "",
                  "pm.test(\"Body de teste deve conter a editora esperada\", function () {",
                  "    pm.expect(JSON.parse(pm.request.body.raw).editor).to.eql(\"Editora Nebulosa\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
